  },
  "info": {
    "title": "Clew API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "description": "The process is up. Does not touch the database.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/me": {
      "get": {
        "description": "Who is signed in. The first call after sign-up creates the Clew account.",
        "operationId": "me_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "403": {
            "description": "The account has no email address (detail: email_required)"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Me",
        "tags": [
          "account"
        ]
      }
    },
    "/profile": {
      "get": {
        "description": "The current version of the signed-in user's profile.",
        "operationId": "get_profile_profile_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileVersionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "No profile yet"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Profile",
        "tags": [
          "profile"
        ]
      },
      "put": {
        "description": "Save the whole profile as a new version. Saving data identical to the current version\nadds nothing and returns the current version.",
        "operationId": "save_profile_profile_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileSave"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileVersionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "409": {
            "description": "base_version_id is no longer the current version"
          },
          "413": {
            "description": "The profile is over 256 KB"
          },
          "422": {
            "description": "The profile doesn't match the schema"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Save Profile",
        "tags": [
          "profile"
        ]
      }
    },
    "/profile/versions": {
      "get": {
        "description": "Saved versions, newest first. Empty before the first save.",
        "operationId": "list_versions_profile_versions_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProfileVersionSummary"
                  },
                  "title": "Response List Versions Profile Versions Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Versions",
        "tags": [
          "profile"
        ]
      }
    },
    "/profile/versions/{version_id}": {
      "get": {
        "description": "One saved version, exactly as it was saved.",
        "operationId": "get_version_profile_versions__version_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "version_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Version Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileVersionOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "No such version for this user"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Version",
        "tags": [
          "profile"
        ]
      }
    },
    "/ready": {
      "get": {
        "description": "The process can reach the database.",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    },
    "/resumes": {
      "post": {
        "description": "Upload a resume (PDF or DOCX, up to 10 MB). The type is checked from the file's content,\nand the file is virus-scanned before it is stored. Reading it into a draft profile starts\nstraight away; follow it with GET /resumes/{id}/parse.",
        "operationId": "upload_resume_resumes_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_resume_resumes_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "413": {
            "description": "The file is over 10 MB"
          },
          "415": {
            "description": "The file is not a PDF or DOCX"
          },
          "422": {
            "description": "The virus scan found something; the file was not kept"
          },
          "503": {
            "description": "File storage or virus scanning is unavailable"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Upload Resume",
        "tags": [
          "resumes"
        ]
      }
    },
    "/resumes/{resume_id}/download": {
      "get": {
        "description": "A signed link to the resume file, valid for 5 minutes. Only the owner gets one.",
        "operationId": "download_resume_resumes__resume_id__download_get",
        "parameters": [
          {
            "in": "path",
            "name": "resume_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Resume Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadLink"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "No such resume for this user"
          },
          "409": {
            "description": "The file hasn't passed the virus check"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "description": "File storage is not set up"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Download Resume",
        "tags": [
          "resumes"
        ]
      }
    },
    "/resumes/{resume_id}/parse": {
      "get": {
        "description": "Where reading the resume has got to, and the draft profile once it's done.",
        "operationId": "get_parse_resumes__resume_id__parse_get",
        "parameters": [
          {
            "in": "path",
            "name": "resume_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Resume Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeParseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "No such resume for this user, or it hasn't been read yet"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Parse",
        "tags": [
          "resumes"
        ]
      },
      "post": {
        "description": "Reads the resume again after a failure. A parse that is in progress or done is\nreturned as it is.",
        "operationId": "restart_parse_resumes__resume_id__parse_post",
        "parameters": [
          {
            "in": "path",
            "name": "resume_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Resume Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResumeParseOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Not signed in"
          },
          "404": {
            "description": "No such resume for this user"
          },
          "409": {
            "description": "The file hasn't passed the virus check"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Another resume is being read, or the daily limit is reached"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Restart Parse",
        "tags": [
          "resumes"
        ]
      }
    }
  }
}
