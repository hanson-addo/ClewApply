# Copy to backend/.env for local development. Placeholder values only.
CLEW_ENV=local
# The API connects as clew_app, which row-level security applies to (see docs/setup/database.md).
CLEW_DATABASE_URL=postgresql+asyncpg://clew_app:clew_app@localhost:5432/clew
# Migrations run as clew, the table owner.
CLEW_MIGRATIONS_DATABASE_URL=postgresql+asyncpg://clew:clew@localhost:5432/clew
CLEW_CORS_ORIGINS=["http://localhost:5173"]
# Clerk "Frontend API URL" from the Clerk dashboard (API keys page). Placeholder below.
# Leave unset to run locally without sign-in; signed-in routes then answer 503.
CLEW_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Resume file storage. These match the local MinIO in docker-compose.yml (local-only values).
# In production use a private bucket with default encryption, and set keys in the host's env.
CLEW_S3_BUCKET=clew-resumes
CLEW_S3_ENDPOINT_URL=http://localhost:9000
CLEW_S3_REGION=us-east-1
CLEW_S3_ACCESS_KEY_ID=clew-local
CLEW_S3_SECRET_ACCESS_KEY=clew-local-only
# Virus scanner (ClamAV's clamd) from docker-compose.yml. Uploads answer 503 without it.
CLEW_CLAMAV_HOST=localhost
CLEW_CLAMAV_PORT=3310
# Background jobs (resume reading) run on the local Redis; start the worker with
# `uv run arq clew.worker.WorkerSettings`.
CLEW_REDIS_URL=redis://localhost:6379/0
# Anthropic API key for reading resumes. Leave empty here; put your own key in .env only.
CLEW_ANTHROPIC_API_KEY=
CLEW_PARSER_MODEL=claude-haiku-5-5
