# Copy to backend/.env for local development. Placeholder values only.
CLEW_ENV=local
CLEW_DATABASE_URL=postgresql+asyncpg://clew:clew@localhost:5432/clew
CLEW_CORS_ORIGINS=["http://localhost:5173"]
# Clerk "Frontend API URL" from the Clerk dashboard (API keys page). Placeholder below.
# Leave unset to run locally without sign-in; signed-in routes then answer 503.
CLEW_CLERK_ISSUER=https://your-instance.clerk.accounts.dev
