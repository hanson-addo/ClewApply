# Copy to apps/web/.env.local. Placeholder values only; everything here ships to the browser.
VITE_API_URL=http://localhost:8000
# Clerk publishable key from the Clerk dashboard (docs/setup/clerk.md). Leave empty to see the
# "sign-in isn't set up" screen.
VITE_CLERK_PUBLISHABLE_KEY=
# The Chrome extension's id. Leave empty to use the id pinned in apps/extension/manifest.config.ts.
VITE_CLEW_EXTENSION_ID=
