# Settings for `docker compose up`. Copy this file to .env (it stays out of git) and fill in
# the two Clerk values. Never commit .env or paste its contents anywhere.

# Clerk dashboard -> Configure -> API keys (see docs/setup/clerk.md).
# "Frontend API URL", like https://your-instance.clerk.accounts.dev
CLEW_CLERK_ISSUER=
# "Publishable key", starts with pk_test_
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. Without it, uploads work and the app says reading resumes is unavailable.
CLEW_ANTHROPIC_API_KEY=
# Optional. Federal jobs from developer.usajobs.gov: the key and the email it was issued to.
CLEW_USAJOBS_API_KEY=
CLEW_USAJOBS_EMAIL=
# The Sync Center's fill-record key. Required in production. Locally (CLEW_ENV=local, as
# docker compose sets it), a fixed local-only key is used if this is blank.
CLEW_FILL_FINGERPRINT_KEY=
